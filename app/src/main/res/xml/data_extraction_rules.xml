<?xml version="1.0" encoding="utf-8"?><!--
   The OpenRouter key is encrypted with an Android Keystore key, which is never backed up,
   so the encrypted value must not be restored either.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
