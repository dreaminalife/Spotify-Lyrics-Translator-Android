<?xml version="1.0" encoding="utf-8"?><!--
   Used on devices older than API 31. The OpenRouter key is encrypted with an
   Android Keystore key, which is never backed up, so the encrypted value is excluded too.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="file" path="datastore/secrets.preferences_pb" />
</full-backup-content>
